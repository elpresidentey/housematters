{
  "name": "house-matters-backend",
  "version": "1.0.0",
  "description": "Backend API for House Matters rental platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node scripts/run-tests.js",
    "test:setup": "node scripts/setup-test-db.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:server": "node scripts/test-server.js",
    "test:auth": "node scripts/run-tests.js auth",
    "test:property": "node scripts/run-tests.js property",
    "test:booking": "node scripts/run-tests.js booking",
    "test:message": "node scripts/run-tests.js message",
    "test:upload": "node scripts/run-tests.js upload",
    "migrate": "node scripts/sqlite-setup.js",
    "seed": "node scripts/seed.js",
    "db:setup": "npm run migrate && npm run seed",
    "db:reset": "npm run migrate && npm run seed --force",
    "db:test:setup": "cross-env NODE_ENV=test npm run test:setup",
    "db:test:reset": "cross-env NODE_ENV=test npm run test:setup --force"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "redis": "^4.6.8",
    "multer": "^1.4.5-lts.1",
    "joi": "^17.9.2",
    "nodemailer": "^6.9.4",
    "stripe": "^13.5.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0",
    "handlebars": "^4.7.8",
    "@aws-sdk/client-s3": "^3.428.0",
    "sharp": "^0.32.6",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "axios": "^1.5.0"
  },
  "keywords": ["rental", "platform", "real-estate", "api"],
